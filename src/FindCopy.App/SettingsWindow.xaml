<Window x:Class="FindCopy.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки производительности" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <StackPanel Margin="18">
    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"
               Text="Значения по умолчанию взяты из ТЗ как стартовые. Уточните их по результатам FindCopy.Bench на своих дисках (build.bat bench). Алгоритм и точность поиска от них не зависят, только скорость."/>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
          </Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
          </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0" Text="Порог «маленького» файла, КиБ (сразу полный хеш)"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ThresholdBox"/>
        <TextBlock Grid.Row="1" Text="Размер быстрой выборки, КиБ"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SampleBox"/>
        <TextBlock Grid.Row="2" Text="Буфер потокового чтения, КиБ"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="BufferBox"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Одновременных полных чтений на один диск:" FontWeight="SemiBold" Margin="0,12,0,2"/>
        <TextBlock Grid.Row="4" Text="HDD"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="HddBox"/>
        <TextBlock Grid.Row="5" Text="SATA SSD"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="SsdBox"/>
        <TextBlock Grid.Row="6" Text="NVMe (максимум)"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="NvmeBox"/>
        <CheckBox Grid.Row="7" Grid.ColumnSpan="2" x:Name="AutotuneBox" Content="Автоподбор для NVMe (от 2 до максимума, пока растёт скорость)"/>
        <TextBlock Grid.Row="8" Text="Сетевой диск"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="NetBox"/>
        <TextBlock Grid.Row="9" Text="Неизвестный носитель"/>
        <TextBox Grid.Row="9" Grid.Column="1" x:Name="UnknownBox"/>
        <CheckBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="FastEnumBox" Margin="0,10,0,0"
                  Content="Быстрый обход папок (FileIdExtdDirectoryInfo, при неудаче — обычный)"/>
      </Grid>
    </Border>
    <Grid Margin="0,14,0,0">
      <Button Content="По умолчанию" HorizontalAlignment="Left" Click="OnDefaults" MinWidth="120"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" IsCancel="True" MinWidth="96" Margin="0,0,8,0"/>
        <Button Content="Сохранить" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk" MinWidth="110"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
