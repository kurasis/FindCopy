<Window x:Class="FindCopy.App.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление удалённых файлов" Width="920" Height="500" MinWidth="700" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Выберите файл, удалённый FindCopy, чтобы вернуть его по исходному пути. Существующие файлы не перезаписываются. Исходная папка должна существовать."
               TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextMain}"/>
    <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OnSelectionChanged"
              EnableRowVirtualization="True" RowHeaderWidth="0" GridLinesVisibility="None">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Удалён" Binding="{Binding Date}" Width="145"/>
        <DataGridTextColumn Header="Исходный путь" Binding="{Binding Entry.OriginalPath}" Width="*">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
              <Setter Property="ToolTip" Value="{Binding Entry.OriginalPath}"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="155"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="RefreshButton" Content="Обновить" Click="OnRefresh" Margin="0,0,8,0"/>
        <Button x:Name="RestoreButton" Content="Восстановить" Click="OnRestore" IsEnabled="False" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
        <Button x:Name="CloseButton" Content="Закрыть" Click="OnClose"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
